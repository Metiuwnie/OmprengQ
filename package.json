{
  "name": "omprengq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "start": "pnpm --filter @mbg/api start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @mbg/api drizzle-kit generate",
    "db:migrate": "pnpm --filter @mbg/api drizzle-kit migrate",
    "db:seed": "pnpm --filter @mbg/api tsx src/db/seed/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.65.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^4.1.0"
  }
}
